# EditorConfig keeps contributors' editors agreeing on whitespace basics.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python: ruff formats at 4 spaces.
[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so they are left alone.
trim_trailing_whitespace = false
