# TrendSentinel Scraper - example environment file.
#
# Copy to `.env` and fill in the required values. Never commit `.env`.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the API and the worker.
# Inside docker compose use host `db`; for local (non-Docker) development use `localhost`.
DATABASE_URL=postgresql://trendsentinel:trendsentinel@db:5432/trendsentinel

# Protects POST /collect/run. Sent by clients as the `X-API-Key` header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left blank, the trigger endpoint is disabled (fails closed with 401).
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# Logging
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | console

# Outbound HTTP behaviour
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
MAX_RESPONSE_BYTES=5000000        # 5 MB hard cap per response
MAX_CONCURRENCY=10                # parallel requests within one collection run
MAX_ITEMS_PER_RUN=100             # hard clamp on any collector's requested limit
MAX_TEXT_CHARS=2000               # truncation length for stored summary text

# Collector identity
USER_AGENT_CONTACT=               # contact URL/email embedded in the User-Agent

# Scheduler
COLLECT_INTERVAL_MINUTES=30       # global floor for per-source intervals
PENDING_POLL_SECONDS=10           # how often the worker picks up manually triggered runs
STALE_RUN_MINUTES=30              # runs older than this are reaped to `failed`
SOURCE_RELOAD_SECONDS=60          # how often the worker re-reads `sources` (no restart needed)

# Retention (purge is disabled unless explicitly enabled)
SNAPSHOT_RETENTION_DAYS=90        # snapshots older than this are past the window
SNAPSHOT_PURGE_ENABLED=false      # true = the worker purges past the window daily, at 03:00 UTC

# Set true only for single-process local development; keeps manual runs inside the API
# process instead of handing them to the worker.
RUN_MANUAL_INLINE=false

# Comma-separated allowlist for HTML/untrusted sources. Empty means no HTML source may run.
ALLOWED_HTML_DOMAINS=

# Comma-separated origin allowlist for the SPA (spec v1.1). Empty means no cross-origin
# request is served, and the browser blocks every read. The SPA is a separate repository, so
# its origin is the only thing it needs from this file: http://localhost:5173 is its dev
# server, http://localhost:5180 is its compose stack.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Self-hosted RSSHub (free X access)
# ---------------------------------------------------------------------------

# Host port RSSHub listens on (read via the rsshub service).
RSSHUB_PORT=1200

# Twitter route credentials. These come from the X developer console (create an app; the
# auth token is obtained from the account's disabled cookies / developer portal). Free — no
# paid tier purchase needed. Leave blank to run RSSHub without the Twitter route.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Test database (used only by the test suite)
# ---------------------------------------------------------------------------

# Must differ from DATABASE_URL: the test suite refuses to run against it.
TEST_DATABASE_URL=postgresql://trendsentinel:trendsentinel@localhost:5432/trendsentinel_test